{
  "name": "xmuoj-vscode",
  "displayName": "XMUOJ",
  "description": "在VSCode/Trae中提供XMUOJ的沉浸式刷题体验。",
  "icon": "media/icon.png",
  "version": "0.1.1",
  "publisher": "xmuoj",
  "scripts": {
    "package": "vsce package --allow-missing-repository --skip-license",
    "check": "node --check src/aiProvider.js && node --check src/client.js && node --check src/codeLens.js && node --check src/extension.js && node --check src/migration.js && node --check src/problemWorkspace.js && node --check src/progress.js && node --check src/runner.js && node --check src/search.js && node --check src/treeData.js && node --check src/workspaceStore.js && node scripts/workspace-store.test.js && node scripts/workspace-migration.test.js && node scripts/progress.test.js && node scripts/search.test.js && node scripts/local-integration.test.js && node scripts/smoke.js",
    "lint": "echo 'Lint rules are not configured yet'"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.17"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "categories": [
    "Education",
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "XMUOJ",
      "properties": {
        "xmuoj.localWorkspaceRoot": {
          "type": "string",
          "default": "",
          "description": "XMUOJ 本地工作区根目录。所有题目统一存放在其下的 problems/<题目标识>/，旧 contest-<id> 与 problemsets 目录会在启动时自动迁移（可回滚）。"
        },
        "xmuoj.editor.shortcuts": {
          "type": "array",
          "default": [
            "start",
            "test",
            "submit",
            "description",
            "results"
          ],
          "items": {
            "type": "string",
            "enum": [
              "start",
              "test",
              "submit",
              "description",
              "results",
              "language",
              "aiSolution",
              "aiCode"
            ]
          },
          "description": "编辑器内显示哪些 XMUOJ 快捷操作（CodeLens）。"
        },
        "xmuoj.enableSideMode": {
          "type": "boolean",
          "default": true,
          "description": "启用刷题 side mode 布局：代码固定在主列，题面与提交结果在旁边列打开，读题与编码可并排进行；关闭后所有面板跟随当前活动列。"
        },
        "xmuoj.colorizeProblems": {
          "type": "boolean",
          "default": true,
          "description": "在题目树中使用图标和颜色强化状态显示，例如 AC、本地通过、已提交。"
        },
        "xmuoj.autoMigrate": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动把旧布局（contest-*/problemsets）中的题目迁移到统一的 problems/ 目录；迁移可回滚，不会删除非空目录。"
        },
        "xmuoj.rememberContestPasswords": {
          "type": "boolean",
          "default": true,
          "description": "进入有密码的实验后，使用系统钥匙串（VS Code SecretStorage）记住密码；可在命令面板执行「忘记实验密码」清除。"
        }
      }
    },
    "commands": [
      {
        "command": "xmuoj.quickStart",
        "title": "快速开始",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.login",
        "title": "登录",
        "category": "XMUOJ",
        "icon": "$(account)"
      },
      {
        "command": "xmuoj.logout",
        "title": "退出登录",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.openContest",
        "title": "打开实验",
        "category": "XMUOJ",
        "icon": "$(trophy)"
      },
      {
        "command": "xmuoj.browseContests",
        "title": "搜索实验",
        "category": "XMUOJ",
        "icon": "$(search)"
      },
      {
        "command": "xmuoj.browseProblemset",
        "title": "打开公共题库",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.openProblemsetProblem",
        "title": "打开题目",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.manageProblemsetSelections",
        "title": "管理刷题队列",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.removeProblemsetSelection",
        "title": "移出刷题队列",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.refreshContest",
        "title": "刷新实验",
        "category": "XMUOJ",
        "icon": "$(refresh)"
      },
      {
        "command": "xmuoj.initContestWorkspace",
        "title": "创建实验题目目录",
        "category": "XMUOJ",
        "icon": "$(new-folder)"
      },
      {
        "command": "xmuoj.revealContestWorkspace",
        "title": "打开实验目录",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.revealProblemsetWorkspace",
        "title": "打开题库目录",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.openProblem",
        "title": "打开题目",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.openContestWorkspaceByItem",
        "title": "切换实验",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.openContestWorkspaceProblem",
        "title": "打开题目",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.manageContestWorkspaceSelections",
        "title": "管理实验",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.removeContestWorkspaceSelection",
        "title": "从实验列表移除",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.startWorkingOnProblem",
        "title": "开始作答",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.createProblemWorkspace",
        "title": "选择本地工作区目录",
        "category": "XMUOJ",
        "icon": "$(folder-opened)"
      },
      {
        "command": "xmuoj.downloadTestCases",
        "title": "下载测试数据",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.checkForUpdates",
        "title": "检查更新",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.generateLocalTasks",
        "title": "生成本地运行任务",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.switchProblemLanguage",
        "title": "切换代码语言",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.generateAiSolution",
        "title": "AI 解题",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.generateAiCode",
        "title": "AI 生成代码",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.rebindCurrentProblem",
        "title": "重新绑定题目",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.runLocalTests",
        "title": "运行本地测试",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.submitCurrentFile",
        "title": "提交评测",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.openOnlineProblem",
        "title": "在浏览器中打开",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.materializeContestWorkspace",
        "title": "批量创建实验工作区",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.showLastLocalReport",
        "title": "查看最近本地测试",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.showLastSubmissionResult",
        "title": "查看最近提交结果",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.showResultPanel",
        "title": "查看结果报表",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.openSubmissionHistoryEntry",
        "title": "打开历史提交",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.manageSubmissionHistory",
        "title": "管理提交历史",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.toggleRecentSubmissionScope",
        "title": "切换提交范围",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.toggleRecentSubmissionDensity",
        "title": "切换提交显示粒度",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.toggleRecentSubmissionResultFilter",
        "title": "切换结果筛选",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.toggleRecentSubmissionLanguageFilter",
        "title": "切换语言筛选",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.showCurrentProblemLatestResult",
        "title": "查看本题最新结果",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.pickProblemHistorySubmission",
        "title": "选择历史提交",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.showAdjacentHistorySubmission",
        "title": "切换相邻历史提交",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.showCurrentProblemDescription",
        "title": "查看题面",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.revealProblemWorkspaceEntry",
        "title": "在资源管理器中定位",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.migrateWorkspaces",
        "title": "迁移本地题目目录",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.rollbackWorkspaceMigration",
        "title": "回滚目录迁移",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.rebuildWorkspaceIndex",
        "title": "重建题目索引",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.fixProblemDirectoryNames",
        "title": "修复题目目录名",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.openRecentProblem",
        "title": "打开题目",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.removeRecentProblem",
        "title": "从最近列表移除",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.openRecentProblemWorkspace",
        "title": "打开本地目录",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.startWorkingOnTreeProblem",
        "title": "开始作答",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.search",
        "title": "搜索题目",
        "category": "XMUOJ",
        "icon": "$(search)"
      },
      {
        "command": "xmuoj.openSettings",
        "title": "账户与设置",
        "category": "XMUOJ",
        "icon": "$(account)"
      },
      {
        "command": "xmuoj.refreshExplorer",
        "title": "刷新工作台",
        "category": "XMUOJ",
        "icon": "$(refresh)"
      },
      {
        "command": "xmuoj.retryBootstrap",
        "title": "重试连接",
        "category": "XMUOJ"
      },
      {
        "command": "xmuoj.forgetContestPassword",
        "title": "忘记实验密码",
        "category": "XMUOJ"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xmuoj",
          "title": "XMUOJ",
          "icon": "media/xmuoj.svg"
        }
      ]
    },
    "views": {
      "xmuoj": [
        {
          "id": "xmuojExplorer",
          "name": "刷题工作台",
          "icon": "media/xmuoj.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xmuojExplorer",
        "contents": "# XMUOJ\n先完成账户设置并登录。\n\n账户： [选择本地工作区目录](command:xmuoj.createProblemWorkspace)  [登录](command:xmuoj.login)\n\n接着就可以浏览比赛、打开题目并开始作答。"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "xmuoj.search",
          "when": "view == xmuojExplorer",
          "group": "navigation@1"
        },
        {
          "command": "xmuoj.refreshExplorer",
          "when": "view == xmuojExplorer",
          "group": "navigation@2"
        },
        {
          "command": "xmuoj.openSettings",
          "when": "view == xmuojExplorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "xmuoj.revealProblemWorkspaceEntry",
          "when": "view == xmuojExplorer && (viewItem == problemWorkspaceFile || viewItem == problemWorkspaceFolder)",
          "group": "navigation"
        },
        {
          "command": "xmuoj.startWorkingOnTreeProblem",
          "when": "view == xmuojExplorer && (viewItem == recentProblem || viewItem == problem || viewItem == problemsetSelection)",
          "group": "inline@1"
        },
        {
          "command": "xmuoj.openRecentProblem",
          "when": "view == xmuojExplorer && viewItem == recentProblem",
          "group": "navigation@1"
        },
        {
          "command": "xmuoj.openRecentProblemWorkspace",
          "when": "view == xmuojExplorer && viewItem == recentProblem",
          "group": "navigation@2"
        },
        {
          "command": "xmuoj.removeRecentProblem",
          "when": "view == xmuojExplorer && viewItem == recentProblem",
          "group": "navigation@3"
        },
        {
          "command": "xmuoj.refreshContest",
          "when": "view == xmuojExplorer && viewItem == contestWorkspace",
          "group": "inline@1"
        },
        {
          "command": "xmuoj.refreshContest",
          "when": "view == xmuojExplorer && viewItem == contestWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "xmuoj.initContestWorkspace",
          "when": "view == xmuojExplorer && viewItem == contestWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "xmuoj.revealContestWorkspace",
          "when": "view == xmuojExplorer && viewItem == contestWorkspace",
          "group": "navigation@3"
        },
        {
          "command": "xmuoj.removeContestWorkspaceSelection",
          "when": "view == xmuojExplorer && viewItem == contestWorkspace",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "xmuoj.revealProblemWorkspaceEntry",
          "when": "editorIsOpen",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "xmuoj.openProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.openProblemsetProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.openContestWorkspaceByItem",
          "when": "false"
        },
        {
          "command": "xmuoj.openContestWorkspaceProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.removeContestWorkspaceSelection",
          "when": "false"
        },
        {
          "command": "xmuoj.removeProblemsetSelection",
          "when": "false"
        },
        {
          "command": "xmuoj.openRecentProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.removeRecentProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.openRecentProblemWorkspace",
          "when": "false"
        },
        {
          "command": "xmuoj.startWorkingOnTreeProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.openSubmissionHistoryEntry",
          "when": "false"
        },
        {
          "command": "xmuoj.showAdjacentHistorySubmission",
          "when": "false"
        }
      ]
    }
  }
}
