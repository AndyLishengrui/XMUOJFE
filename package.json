        },
        {
          "command": "xmuoj.removeContestWorkspaceSelection",
          "when": "view == xmuojExplorer && viewItem == contestQuestionBank",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "xmuoj.timeCapsule.stop",
          "when": "xmuoj.timeCapsuleRecording",
          "group": "navigation@8"
        },
        {
          "command": "xmuoj.timeCapsule.replayProblem",
          "when": "xmuoj.activeProblemFile && xmuoj.activeProblemHasCapsules && !xmuoj.timeCapsuleRecording",
          "group": "navigation@10"
        },
        {
          "command": "xmuoj.timeCapsule.start",
          "when": "xmuoj.activeProblemFile && !xmuoj.activeProblemHasCapsules && !xmuoj.timeCapsuleRecording",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "xmuoj.revealProblemWorkspaceEntry",
          "when": "editorIsOpen",
          "group": "navigation"
        },
        {
          "command": "xmuoj.timeCapsule.replayProblem",
          "when": "xmuoj.activeProblemFile",
          "group": "xmuoj@10"
        },
        {
          "command": "xmuoj.timeCapsule.start",
          "when": "xmuoj.activeProblemFile && !xmuoj.timeCapsuleRecording",
          "group": "xmuoj@11"
        },
        {
          "command": "xmuoj.timeCapsule.stop",
          "when": "xmuoj.timeCapsuleRecording",
          "group": "xmuoj@11"
        },
        {
          "command": "xmuoj.fixCppUniversalHeader",
          "when": "editorLangId == cpp",
          "group": "xmuoj@12"
        }
      ],
      "commandPalette": [
        {
          "command": "xmuoj.openProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.openProblemsetProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.openContestWorkspaceByItem",
          "when": "false"
        },
        {
          "command": "xmuoj.openContestWorkspaceProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.removeContestWorkspaceSelection",
          "when": "false"
        },
        {
          "command": "xmuoj.removeProblemsetSelection",
          "when": "false"
        },
        {
          "command": "xmuoj.openRecentProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.removeRecentProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.openRecentProblemWorkspace",
          "when": "false"
        },
        {
          "command": "xmuoj.startWorkingOnTreeProblem",
          "when": "false"
        },
        {
          "command": "xmuoj.openSubmissionHistoryEntry",
          "when": "false"
        },
        {
          "command": "xmuoj.showAdjacentHistorySubmission",
          "when": "false"
        },
        {
          "command": "xmuoj.timeCapsule.statusMenu",
          "when": "false"
        },
        {
          "command": "xmuoj.timeCapsule.open",
          "when": "false"
        }
      ]
    }
  }
}
