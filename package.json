{
  "name": "xmuoj-vscode",
  "displayName": "XMUOJ",
  "description": "在VSCode/Trae中提供XMUOJ的沉浸式刷题体验。",
  "icon": "media/icon.png",
  "version": "0.1.6",
  "publisher": "xmuoj",
  "scripts": {
    "package": "vsce package --allow-missing-repository --skip-license",
    "check": "node --check media/problemset/app.js && node --check media/contestrace/app.js && node --check media/shared/capsule-format.js && node --check media/timecapsule/player.js && node --check src/aiProvider.js && node --check src/client.js && node --check src/contestList.js && node --check src/contestRaceWorkbench.js && node --check src/codeLens.js && node --check src/dataMigration.js && node --check src/extension.js && node --check src/languageTemplates.js && node --check src/migration.js && node --check src/problemWorkspace.js && node --check src/problemsetCatalog.js && node --check src/problemsetInsights.js && node --check src/problemsetQueue.js && node --check src/problemsetRace.js && node --check src/problemsetRanking.js && node --check src/problemsetWorkbench.js && node --check src/progress.js && node --check src/runner.js && node --check src/search.js && node --check src/siteApi.js && node --check src/timeCapsuleLibrary.js && node --check src/timeCapsulePanel.js && node --check src/timeCapsuleRecorder.js && node --check src/timeCapsuleStore.js && node --check src/treeData.js && node --check src/workspaceStore.js && node scripts/data-migration.test.js && node scripts/workspace-store.test.js && node scripts/workspace-migration.test.js && node scripts/progress.test.js && node scripts/search.test.js && node scripts/site-api.test.js && node scripts/problemset-catalog.test.js && node scripts/problemset-queue.test.js && node scripts/problemset-ranking.test.js && node scripts/problemset-race.test.js && node scripts/contest-list.test.js && node scripts/contest-race.test.js && node scripts/problemset-insights.test.js && node scripts/problemset-workbench.test.js && node scripts/time-capsule-format.test.js && node scripts/time-capsule-library.test.js && node scripts/time-capsule-store.test.js && node scripts/time-capsule-recorder.test.js && node scripts/time-capsule-panel.test.js && node scripts/code-lens.test.js && node scripts/language-templates.test.js && node scripts/local-integration.test.js && node scripts/smoke.js",
    "lint": "echo 'Lint rules are not configured yet'"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.17"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "categories": [
    "Education",
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "XMUOJ",
      "properties": {
        "xmuoj.localWorkspaceRoot": {
          "type": "string",
          "default": "",
          "description": "XMUOJ 本地工作区根目录。所有题目统一存放在其下的 problems/<题目标识>/，旧 contest-<id> 与 problemsets 目录会在启动时自动迁移（可回滚）。"
        },
        "xmuoj.editor.shortcuts": {
          "type": "array",
          "default": [
            "start",
            "test",
            "submit",
            "description",
            "results",
            "replay"
          ],
          "items": {
            "type": "string",
            "enum": [
              "start",
              "test",
              "submit",
              "description",
              "results",
              "language",
              "replay",
              "aiSolution",
              "aiCode"
            ]
          },
          "description": "编辑器内显示哪些 XMUOJ 快捷操作（CodeLens）。"
        },
        "xmuoj.enableSideMode": {
          "type": "boolean",
          "default": true,
          "description": "启用刷题 side mode 布局：代码固定在主列，题面与提交结果在旁边列打开，读题与编码可并排进行；关闭后所有面板跟随当前活动列。"
        },
        "xmuoj.colorizeProblems": {
          "type": "boolean",
          "default": true,
          "description": "在题目树中使用图标和颜色强化状态显示，例如 AC、本地通过、已提交。"
        },
        "xmuoj.problemset.catalogTtlMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "刷题台题目目录缓存的有效期（分钟）。到期后在后台重新同步，期间继续显示旧数据。"
        },
        "xmuoj.problemset.pageSize": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 200,
          "description": "刷题台题库每页显示的题目数量。"
        },
        "xmuoj.race.pollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 120,
          "description": "实时竞速轮询对手提交的间隔（秒）。网络不稳定时会自动退避，截止前两分钟会提速。"
        },
        "xmuoj.timeCapsule.maxSizeMB": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "单个代码时间胶囊的大小上限（MB）。达到上限时自动停止并保存已录制内容。"
        },
        "xmuoj.timeCapsule.checkpointSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 600,
          "description": "时间胶囊写入完整文本检查点的间隔（秒）。检查点越密，回放定位越快、文件越大。"
        },
        "xmuoj.timeCapsule.recordCursor": {
          "type": "boolean",
          "default": true,
          "description": "录制时保存光标与选区，回放可以看到当时的编辑位置。关闭后胶囊更小。"
        },
        "xmuoj.timeCapsule.videoFps": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 60,
          "description": "时间胶囊导出 WebM 视频的帧率。帧率越高越流畅，文件也越大。"
        },
        "xmuoj.timeCapsule.videoWidth": {
          "type": "number",
          "default": 1280,
          "minimum": 640,
          "maximum": 3840,
          "description": "导出视频的宽度（像素），默认 1280×720。"
        },
        "xmuoj.timeCapsule.videoHeight": {
          "type": "number",
          "default": 720,
          "minimum": 360,
          "maximum": 2160,
          "description": "导出视频的高度（像素），默认 1280×720。"
        },
        "xmuoj.autoMigrate": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动把旧布局（contest-*/problemsets）中的题目迁移到统一的 problems/ 目录；迁移可回滚，不会删除非空目录。"
        },
        "xmuoj.rememberContestPasswords": {
          "type": "boolean",
          "default": true,
          "description": "进入有密码的实验后，使用系统钥匙串（VS Code SecretStorage）记住密码；可在命令面板执行「忘记实验密码」清除。"
        }
      }
    },
